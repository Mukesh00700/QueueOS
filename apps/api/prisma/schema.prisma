// QueueOS AI — data model
//
// Portability note: moved from SQLite to Postgres on 2026-09-08 (see
// decision.md). Enum-like columns deliberately stay validated Strings rather
// than native Postgres enums — that promotion is optional per the original
// design and isn't needed for correctness, since application code already
// validates them (packages/core/src/enums.ts). JSON payloads stay TEXT rather
// than a native JSON column, for the same portability-over-cleverness reason.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// VerticalId from @queueos/core — drives terminology, journey and theme.
  vertical  String
  logoUrl   String?
  /// Hex accent overriding the vertical default, for white-label tenants.
  brandColor String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches   Branch[]
  staff      StaffUser[]
  customers  Customer[]
  visits     Visit[]
  orders     Order[]
  products   Product[]
  invoices   Invoice[]
  events     QueueEvent[]
}

model Branch {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  code           String
  timezone       String  @default("Asia/Kolkata")
  address        String?
  /// Per-branch vertical override; falls back to the organization's.
  vertical       String?
  openTime       String  @default("09:00")
  closeTime      String  @default("18:00")
  /// Next invoice number to issue for this branch; same pattern as
  /// Queue.nextNumber.
  nextInvoiceNumber Int @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queues       Queue[]
  counters     Counter[]
  staff        StaffUser[]
  tokens       Token[]
  visits       Visit[]
  orders       Order[]
  invoices     Invoice[]
  events       QueueEvent[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Queue configuration
// ---------------------------------------------------------------------------

model Queue {
  id       String @id @default(cuid())
  branchId String
  name        String
  /// Department / section grouping, e.g. "Cardiology".
  department  String?
  /// QueueStatus: OPEN | PAUSED | CLOSED
  status      String  @default("OPEN")
  tokenPrefix String  @default("A")
  /// Next display number to issue; reset by the daily rollover job.
  nextNumber  Int     @default(1)
  /// Fallback service estimate before enough history exists, in minutes.
  baselineServiceMinutes Int @default(8)
  /// Minutes a called customer has to appear before recall kicks in.
  recallGraceMinutes     Int @default(3)
  /// How many positions a no-show is pushed back on a confirmed recall.
  recallPenaltyPositions Int @default(5)
  displayOrder Int    @default(0)

  /// StageType from @queueos/core — see queue-flow-design.md §3. Drives
  /// default terminology/UI once something reads it; unenforced today.
  stageType String @default("CUSTOM")
  /// The queue a token advances into once this one's stage completes, if
  /// configured. Nullable and inert until Phase 6 (auto-advance) reads it —
  /// see build-plan.md. Deliberately not required to be in the same branch at
  /// the schema level (Prisma can't express that constraint); enforced in
  /// QueueService.update() instead.
  nextQueueId String?
  /// Whether this stage shows a visible position/ETA queue, or is a quick
  /// transaction step (typically a PAYMENT stage) with no line to watch.
  hasVisibleQueue Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  counters Counter[]
  tokens   Token[]
  services ServiceType[]
  events   QueueEvent[]

  nextQueue      Queue?  @relation("QueueStageChain", fields: [nextQueueId], references: [id], onDelete: SetNull)
  previousQueues Queue[] @relation("QueueStageChain")

  @@index([branchId, status])
}

model ServiceType {
  id       String @id @default(cuid())
  queueId  String
  name     String
  /// Expected duration used for mixed-service queues, in minutes.
  durationMinutes Int @default(8)
  createdAt DateTime @default(now())

  queue  Queue   @relation(fields: [queueId], references: [id], onDelete: Cascade)
  tokens Token[]

  @@index([queueId])
}

model Counter {
  id       String @id @default(cuid())
  branchId String
  queueId  String?
  name     String
  /// CounterStatus: IDLE | SERVING | BREAK | CLOSED
  status   String @default("IDLE")
  /// Display name of the doctor / stylist / officer currently at this counter.
  providerName String?
  /// Staff member signed in to this counter.
  staffUserId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  queue  Queue?     @relation(fields: [queueId], references: [id], onDelete: SetNull)
  staff  StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  tokens Token[]

  @@index([branchId])
  @@index([queueId, status])
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model StaffUser {
  id             String @id @default(cuid())
  organizationId String
  branchId       String?
  name           String
  email          String  @unique
  passwordHash   String
  /// Role from @queueos/core.
  role           String
  active         Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  counters     Counter[]

  @@index([organizationId])
}

model Customer {
  id             String @id @default(cuid())
  organizationId String
  name           String
  phone          String
  email          String?
  /// Accessibility and priority signals captured at check-in.
  isSeniorCitizen Boolean @default(false)
  needsAssistance Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokens       Token[]
  visits       Visit[]

  @@unique([organizationId, phone])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Visits — one customer occasion at a branch. The backbone a customer's
// stage-tokens hang off; today that's exactly one token each (see
// queue-flow-design.md §6 for why this exists ahead of the multi-stage work
// it's actually for).
// ---------------------------------------------------------------------------

model Visit {
  id             String @id @default(cuid())
  organizationId String
  branchId       String
  customerId     String?

  /// VisitStatus: OPEN | CLOSED. Closed when a completed stage has no
  /// nextQueueId to advance into — see AutoAdvanceService.
  status String @default("OPEN")
  /// CheckinSource from @queueos/core.
  source String
  /// VerticalId at the moment the visit was created — a snapshot, not a live
  /// join to the branch, so a later vertical change doesn't rewrite history.
  vertical String

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tokens       Token[]
  orders       Order[]

  @@index([branchId, status])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Commerce — line items, invoices, catalogue, stock. Started minimal in
// build-plan.md Phase 8 (just enough for a PAYMENT-typed stage to gate on a
// real payment) and extended here into the real thing per plan.md Phase 1a.
// Still deliberately small: GST calculation, the cart-building POS UI, shift
// close and stock depletion are their own later steps — see plan.md.
// ---------------------------------------------------------------------------

model Product {
  id             String @id @default(cuid())
  organizationId String
  name           String
  /// Free-text grouping — display/filtering only. GST rate is set directly
  /// per product below, not looked up by this string: real GST is assigned
  /// per HSN/SAC code, not by a loosely-typed category label.
  category       String
  price          Float
  /// HSN (goods) or SAC (services) code, for GST invoicing. Optional until
  /// that step actually needs it.
  hsnSac         String?
  /// GST percentage (e.g. 18 for 18%) applied to this product's line items.
  /// A flat rate table, not a tax service — see plan.md Phase 1d.
  gstRate        Float    @default(0)
  /// Opt-in: most verticals (hospital, salon, temple) sell nothing that
  /// needs stock tracked; a retail/QSR product can turn this on.
  trackStock     Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([organizationId])
}

model Order {
  id             String @id @default(cuid())
  organizationId String
  branchId       String
  visitId        String
  /// Denormalised sum of `items[].lineTotal`, recomputed whenever items
  /// change — same "recalculate on mutation" shape as a queue's live stats.
  subtotal       Float    @default(0)
  /// Denormalised sum of each item's `lineTotal * gstRate / 100`, recomputed
  /// alongside `subtotal`.
  taxAmount      Float    @default(0)
  /// OrderStatus: OPEN | PAID.
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  visit        Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  items        OrderItem[]
  invoice      Invoice?

  @@index([visitId])
  @@index([branchId, createdAt])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  /// Nullable — an ad-hoc line (today's "just type an amount") doesn't need
  /// a catalogue entry.
  productId   String?
  description String
  quantity    Int    @default(1)
  unitPrice   Float
  lineTotal   Float
  /// Snapshotted from Product.gstRate at add-time — same reasoning as
  /// unitPrice/description already being copied rather than live-joined: a
  /// later rate change shouldn't rewrite an invoice that already went out.
  gstRate     Float  @default(0)
  /// Staff who rang up this line. Plain id, no FK — same loose-actor
  /// convention as QueueEvent.actorId. This is the line-level attribution
  /// commission/productivity reporting needs later.
  staffUserId String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Invoice {
  id             String @id @default(cuid())
  organizationId String
  branchId       String
  orderId        String @unique
  /// Per-branch incrementing series, e.g. "INV-42" — same pattern as
  /// Queue.nextNumber.
  number         String
  subtotal       Float
  /// Sum of the order's item-level GST at issue time. 0 for an ad-hoc line
  /// (no product, no rate) — the flat "type an amount" fallback never gets
  /// taxed.
  taxAmount      Float    @default(0)
  total          Float
  /// InvoiceStatus: ISSUED | VOID.
  status         String   @default("ISSUED")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@unique([branchId, number])
  @@index([branchId, createdAt])
}

model Payment {
  id        String @id @default(cuid())
  /// Not unique — an invoice can carry multiple payments for split tender,
  /// even though this step only ever writes one.
  invoiceId String
  amount    Float
  /// PaymentMethod from @queueos/core.
  method    String
  /// Staff user who recorded it. Plain id, no FK — same loose-actor
  /// convention as QueueEvent.actorId.
  recordedBy String?
  recordedAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model StockMovement {
  id          String @id @default(cuid())
  productId   String
  /// The sale line that caused this movement, when there is one.
  orderItemId String?
  /// Negative on sale. No separate "current stock" table — stock-on-hand is
  /// computed by summing movements, the same pattern QueueEvent already
  /// uses for history. Inert until the depletion step writes to it.
  quantity    Int
  reason      String
  occurredAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, occurredAt])
}

// ---------------------------------------------------------------------------
// Tokens — the core entity
// ---------------------------------------------------------------------------

model Token {
  id       String @id @default(cuid())
  branchId String
  queueId  String
  customerId String?
  counterId  String?
  serviceTypeId String?
  /// One row per stage a visit passes through — a single-stage branch has
  /// exactly one, a multi-stage branch gets one per stage as auto-advance
  /// (Phase 6) walks the chain.
  visitId String

  /// Public short code used in the customer URL and QR. Unguessable.
  code          String @unique
  /// The number shown on the board, e.g. 52 in "A52".
  displayNumber Int
  /// TokenStatus from @queueos/core.
  status        String @default("WAITING")
  /// Priority from @queueos/core.
  priority      String @default("NORMAL")
  /// CheckinSource from @queueos/core.
  source        String @default("WEB")

  /// Sort key within the queue. Priority band first, then join order.
  /// Recomputed on recall so a returning customer keeps a fair, explainable slot.
  sortKey Float

  /// Last authoritative ETA, so a reconnecting client sees a value immediately.
  etaMinutes    Int?
  etaConfidence Float?

  joinedAt    DateTime  @default(now())
  calledAt    DateTime?
  servedAt    DateTime?
  completedAt DateTime?
  /// When the current recall attempt expires.
  recallExpiresAt DateTime?
  recallAttempts  Int @default(0)

  /// Denormalised service duration in minutes, written on completion. Feeds the
  /// rolling ETA statistics without re-scanning timestamps on every read.
  serviceMinutes Float?
  /// Actual wait from join to called, in minutes. Feeds analytics.
  waitMinutes    Float?

  notes String?

  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  queue       Queue        @relation(fields: [queueId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  counter     Counter?     @relation(fields: [counterId], references: [id], onDelete: SetNull)
  serviceType ServiceType? @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  visit         Visit          @relation(fields: [visitId], references: [id], onDelete: Cascade)
  notifications Notification[]
  feedback      Feedback?
  events        QueueEvent[]

  @@index([queueId, status, sortKey])
  @@index([branchId, joinedAt])
  @@index([visitId])
}

model Notification {
  id      String @id @default(cuid())
  tokenId String
  /// NotificationChannel from @queueos/core.
  channel String
  /// Threshold that triggered it, e.g. 15 for the 15-minute warning. Null for ad-hoc.
  thresholdMinutes Int?
  title   String
  body    String
  sentAt  DateTime @default(now())
  /// Delivery outcome. No real gateway is wired up yet, so this is SIMULATED.
  status  String   @default("SIMULATED")

  token Token @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId])
  @@unique([tokenId, thresholdMinutes])
}

model Feedback {
  id      String @id @default(cuid())
  tokenId String @unique
  rating  Int
  comment String?
  createdAt DateTime @default(now())

  token Token @relation(fields: [tokenId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Event log — append-only, drives realtime fan-out, analytics and audit
// ---------------------------------------------------------------------------

model QueueEvent {
  id             String @id @default(cuid())
  organizationId String
  branchId       String
  queueId        String?
  tokenId        String?
  /// QueueEventName from @queueos/core.
  name           String
  actorId        String?
  /// JSON-encoded payload. TEXT rather than a JSON column to stay portable.
  payload        String @default("{}")
  occurredAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  queue        Queue?       @relation(fields: [queueId], references: [id], onDelete: SetNull)
  token        Token?       @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([branchId, occurredAt])
  @@index([queueId, occurredAt])
  @@index([name, occurredAt])
}
